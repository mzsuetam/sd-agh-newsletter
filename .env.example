# =============================================================================
# sd.agh.edu.pl Aktualnosci -> newsletter
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# --- SMTP (same variables as hello.py) ---------------------------------------
# NOTE: the AGH mail server may only accept logins from its own network.
# For local testing, point these at a local catch-all SMTP (e.g. Mailpit on 1025).
SMTP_HOST="poczta.agh.edu.pl"
SMTP_PORT="465"
SENDER_EMAIL="your-account@agh.edu.pl"
APP_PASSWORD="your-app-password"

# Display name used in the "From" header of outgoing mail.
SENDER_NAME="Newsletter Szkoly Doktorskiej AGH (nieoficjalny)"

# --- Application -------------------------------------------------------------
# Secret used to sign verification / unsubscribe tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-to-a-long-random-string"

# Public base URL of this app. Used to build verify + unsubscribe links.
BASE_URL="http://localhost:8000"

# SQLite database path. Inside Docker this should live on the /data volume.
DB_PATH="./data/app.db"

# Times of day (local Europe/Warsaw) at which the watcher checks for new posts.
# Default: once a day at midnight, so a full day's posts are ready to send.
# Comma-separated 24h hours (e.g. "0" or "9,17,21").
SCHEDULE_HOURS="0"

# Legacy interval knob; unused by the default cron schedule. Kept for
# backwards compatibility only.
CHECK_INTERVAL_SECONDS="3600"

# How long an email verification link stays valid, in seconds (86400 = 24h).
VERIFY_TOKEN_TTL_SECONDS="86400"

# --- Scraper -----------------------------------------------------------------
# Base of the news section. Override only for testing against a mirror.
NEWS_BASE_URL="https://sd.agh.edu.pl/aktualnosci"

# --- Safety rails ------------------------------------------------------------
# Never email real subscribers while testing. "1" forces a dry run globally.
DRY_RUN="0"

# Optional: when set, ALL newsletter mail is redirected to this single address
# (useful for testing an actual send without spamming subscribers).
TEST_REDIRECT_EMAIL=""
